{
	"type": "module",
	"name": "@open-agents/swarm-extension",
	"version": "15.8.1",
	"description": "Swarm orchestration extension for open-agent",
	"homepage": "https://github.com/ZacharyEllison/open-agents",
	"author": "Derek Rynd",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ZacharyEllison/open-agents.git",
		"directory": "packages/swarm-extension"
	},
	"bugs": {
		"url": "https://github.com/ZacharyEllison/open-agents/issues"
	},
	"keywords": [
		"swarm",
		"orchestration",
		"agent",
		"extension"
	],
	"bin": {
		"omp-swarm": "src/cli.ts"
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"fix": "biome check --write --unsafe .",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@open-agents/utils": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14"
	},
	"peerDependencies": {
		"@open-agents/coding-agent": "workspace:*"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"omp": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"src",
		"README.md"
	]
}
