# VHS tape: open-agent TUI demo → docs/assets/demo.gif
Output docs/assets/demo.gif

Require bun
Require bash

Set Shell "bash"
Set FontSize 14
Set Width 1200
Set Height 640
Set Theme "Catppuccin Mocha"
Set Padding 24
Set Framerate 24
Set TypingSpeed 10ms
Set PlaybackSpeed 1.0
Set LoopOffset 88%

Type "bash scripts/demo-session.sh" Enter
Sleep 16s
